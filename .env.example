# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/deccan_harvests

# ── JWT (generate with: openssl rand -base64 48) ─────────────────────────────
JWT_ACCESS_SECRET=replace_with_256bit_random_string_minimum_32_chars
JWT_REFRESH_SECRET=replace_with_different_256bit_random_string_minimum_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AWS S3 (optional — only needed for Phase 7 media uploads) ────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=deccan-harvests-media

# ── Brevo (transactional email) ───────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@deccanharvests.com
ADMIN_EMAIL=exports@deccanharvests.com
